{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Static Buildchain infra-contract CloudFormation fixture",
  "Resources": {
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "Properties": {
        "BucketName": "example-cloudformation-preview"
      }
    }
  },
  "Outputs": {
    "BucketName": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "DistributionId": {
      "Value": "E-CLOUDFORMATION-PREVIEW"
    }
  }
}
