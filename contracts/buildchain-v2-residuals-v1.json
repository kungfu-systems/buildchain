{
  "contract": "buildchain.v2-residual-inventory/v1",
  "scope": ".github/workflows on the current default branch",
  "policy": {
    "runtimeDefault": "v3",
    "dogfoodRuntimeDefault": "v3-alpha",
    "unclassifiedV2TokensAllowed": false
