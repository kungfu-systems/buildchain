{
  "schemaVersion": 1,
  "contract": "kungfu-buildchain-v4-platform-stage-checkpoints",
  "capsuleAuthority": "architecture/v4-stage-capsule-contract.json",
  "storeAuthority": "architecture/v4-stage-capsule-store-contract.json",
  "mode": "shadow-only",
  "platforms": [
    {
      "id": "linux-x64",
      "os": "linux",
      "arch": "x64",
      "runner": "ubuntu-24.04"
    },
    {
      "id": "macos-arm64",
      "os": "macos",
      "arch": "arm64",
      "runner": "macos-15"
    },
    {
      "id": "windows-x64",
      "os": "windows",
      "arch": "x64",
      "runner": "windows-2025"
    }
  ],
  "stages": [
    {
      "id": "checkout-input",
      "inputs": ["source-tree"],
      "outputs": [{ "name": "source-layout", "path": "source/layout.json" }],
      "environment": [],
      "toolchains": ["git"],
      "providerEffects": false
    },
    {
      "id": "install",
      "inputs": ["lockfile", "source-tree"],
      "outputs": [
        { "name": "dependency-layout", "path": "install/dependencies.json" }
      ],
      "environment": ["package-manager"],
      "toolchains": ["node"],
      "providerEffects": false
    },
    {
      "id": "build",
      "inputs": ["dependency-layout", "source-tree"],
      "outputs": [{ "name": "build-output", "path": "build/output.bin" }],
      "environment": ["build-profile"],
      "toolchains": ["node"],
      "providerEffects": false
    },
    {
      "id": "verify",
      "inputs": ["build-output", "source-tree"],
      "outputs": [
        { "name": "verification-report", "path": "verify/report.json" }
      ],
      "environment": ["verification-profile"],
      "toolchains": ["node"],
      "providerEffects": false
    },
    {
      "id": "package",
      "inputs": ["build-output", "source-tree", "verification-report"],
      "outputs": [{ "name": "package-archive", "path": "package/archive.bin" }],
      "environment": ["package-profile"],
      "toolchains": ["node"],
      "providerEffects": false
    },
    {
      "id": "signing-preparation",
      "inputs": ["package-archive", "source-tree"],
      "outputs": [
        { "name": "signing-request", "path": "signing/request.json" }
      ],
      "environment": ["signing-profile"],
      "toolchains": ["node"],
      "providerEffects": false
    }
  ],
  "projections": {
    "protectedWorkflow": ".github/workflows/verify.yml",
    "generatedTemplate": "scripts/init-repo.mjs",
    "agentGuidance": "AGENTS.md",
    "manual": "docs/v4-stage-capsule.md"
  },
  "authority": {
    "productionStageSkipping": false,
    "providerEffects": false,
    "credentials": false,
    "ambientEnvironment": false,
    "ambientClock": false,
    "v3BehaviorChange": false
  }
}
