      },
      {
        "id": "readback",
        "consumes": ["all declared readback predicates"],
        "emits": ["verified observations", "readback receipt"]
      },
      {
        "id": "settle",
        "consumes": ["all required receipt roots"],
        "emits": ["released evidence", "terminal classification"]
      }
    ],
