{
  "schema": "buildchain.build-orchestration/v1",
  "configurationAuthority": "buildchain.toml",
  "ordinaryInputs": ["config-path"],
  "backbone": ".github/workflows/.build.yml",
  "facade": ".github/workflows/build.yml",
  "jobs": [
    "plan",
    "build-native",
    "build-container",
    "sign",
    "attest",
    "deliver"
  ],
  "maximumBackboneLines": 280,
  "maximumFacadeLines": 80,
  "maximumCompositeLines": 130,
  "maximumModuleLines": 220,
  "lifecycleOrder": ["install", "build", "verify"],
  "contracts": [
    "buildchain.build-plan/v1",
    "buildchain.build-artifact/v1",
    "buildchain.build-result/v1"
  ],
  "owners": {
    "actions/build/resolve-plan/action.yml": "Buildchain configuration maintainers",
    "actions/build/prepare-environment/action.yml": "Buildchain infrastructure maintainers",
    "actions/build/run-stage/action.yml": "Buildchain lifecycle maintainers",
    "actions/build/transfer-artifact/action.yml": "Buildchain artifact transport maintainers",
    "actions/build/sign-artifact/action.yml": "Buildchain signing maintainers",
    "actions/build/attest-artifact/action.yml": "Buildchain attestation maintainers",
    "actions/build/finalize-result/action.yml": "Buildchain evidence maintainers"
  },
  "modules": [
    "packages/core/build/commands/artifact-contract.mjs",
    "packages/core/build/commands/artifact-store.mjs",
    "packages/core/build/commands/attest.mjs",
    "packages/core/build/commands/context.mjs",
    "packages/core/build/commands/finalize.mjs",
    "packages/core/build/commands/plan.mjs",
    "packages/core/build/commands/prepare.mjs",
    "packages/core/build/commands/sign.mjs",
    "packages/core/build/commands/stage.mjs",
    "packages/core/build/commands/transfer.mjs"
  ]
}
