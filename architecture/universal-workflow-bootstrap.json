    "publicWorkflow": ".github/workflows/public-ops-bootstrap.yml",
    "requestSchema": "kungfu-buildchain-v4-universal-workflow-request/v1",
    "admissionSchema": "kungfu-buildchain-v4-universal-workflow-admission/v1",
