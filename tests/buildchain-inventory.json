{
  "schemaVersion": 2,
  "release": "buildchain-v1",
  "workflowSources": [
    {
      "repo": "workflows",
      "previousBranch": "dev/v2/v2.0",
      "disposition": "migrated-to-root-workflows"
    }
  ],
  "migratedActions": [
    {
      "path": "actions/approve",
      "previousRepo": "action-approve",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/approve/dist/index.js"
    },
    {
      "path": "actions/batch-pull-request",
      "previousRepo": "action-batch-pull-request",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/batch-pull-request/dist/index.js"
    },
    {
      "path": "actions/bump-version",
      "previousRepo": "action-bump-version",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/bump-version/dist/index.js"
    },
    {
      "path": "actions/check-format",
      "previousRepo": "action-check-format",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/check-format/dist/index.js"
    },
    {
      "path": "actions/generate-download-page",
      "previousRepo": "action-generate-download-page",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/generate-download-page/dist/index.js"
    },
    {
      "path": "actions/generate-release-page",
      "previousRepo": "action-generate-release-page",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/generate-release-page/dist/index.js"
    },
    {
      "path": "actions/merge-close-issue",
      "previousRepo": "action-merge-close-issue",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/merge-close-issue/dist/index.js"
    },
    {
      "path": "actions/publish-prebuilt",
      "previousRepo": "action-publish-prebuilt",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/publish-prebuilt/dist/index.js"
    },
    {
      "path": "actions/qa-automated",
      "previousRepo": "action-qa-automated",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/qa-automated/dist/index.js"
    },
    {
      "path": "actions/rollback-release",
      "previousRepo": "action-rollback-release",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/rollback-release/dist/index.js"
    },
    {
      "path": "actions/sync-pr",
      "previousRepo": "action-sync-pr",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/sync-pr/dist/index.js"
    },
    {
      "path": "actions/update-dependencies-version",
      "previousRepo": "action-update-dependencies-version",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/update-dependencies-version/dist/index.js"
    }
  ],
  "internalActions": [
    {
      "path": "actions/promote-buildchain-ref",
      "disposition": "buildchain-self-promotion",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/promote-buildchain-ref/dist/index.js"
    },
    {
      "path": "actions/run-lifecycle",
      "disposition": "buildchain-reusable-build-surface",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/run-lifecycle/dist/index.js"
    },
    {
      "path": "actions/validate-config",
      "disposition": "buildchain-config-preflight",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/validate-config/dist/index.js"
    }
  ],
  "retiredActionsExcluded": [
    "action-find-dependencies",
    "action-package-dependency",
    "action-purge-artifacts",
    "action-release-note",
    "action-set-collaborators",
    "action-sync-airtable",
    "action-sync-extensions-version"
  ],
  "stableRefs": {
    "actions": "kungfu-systems/buildchain/actions/<name>@v1",
    "workflows": "kungfu-systems/buildchain/.github/workflows/<workflow>.yml@v1"
  },
  "verification": [
    "buildchain.toml lifecycle.verify",
    "pnpm install --frozen-lockfile",
    "pnpm run check",
    "GitHub Verify workflow",
    "Build Surface Fixture workflow",
    "manual Self-hosted Runner Smoke workflow"
  ],
  "safety": {
    "forkPrSecretsDefault": false,
    "selfHostedRunnerDefault": false,
    "trustedEventGate": true,
    "selfHostedRunnerManualWorkflow": "self-hosted-runner-smoke.yml",
    "reusableBuildWorkflow": ".build.yml",
    "reusableContract": {
      "runnerPresets": [
        "github-hosted",
        "kungfu-v4-self-hosted",
        "custom"
      ],
      "artifactNameTemplate": true,
      "expectedArtifactSummary": true,
      "aggregateSummaryArtifact": true
    },
    "libnodeShapedFixture": "fixtures/libnode-shaped",
    "buildchainRefPromotionWorkflow": "buildchain-ref-promotion.yml"
  }
}
