{
  "schemaVersion": 2,
  "release": "buildchain-v2",
  "workflowSources": [
    {
      "repo": "workflows",
      "previousBranch": "dev/v2/v2.0",
      "disposition": "migrated-to-root-workflows"
    }
  ],
  "migratedActions": [],
  "internalActions": [
    {
      "path": "actions/promote-buildchain-ref",
      "disposition": "buildchain-self-promotion",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/promote-buildchain-ref/dist/index.js"
    },
    {
      "path": "actions/run-lifecycle",
      "disposition": "buildchain-reusable-build-surface",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/run-lifecycle/dist/index.js"
    },
    {
      "path": "actions/validate-config",
      "disposition": "buildchain-config-preflight",
      "runtime": "node24",
      "build": "tsup",
      "bundle": "actions/validate-config/dist/index.js"
    }
  ],
  "retiredActionsExcluded": [
    "action-approve",
    "action-batch-pull-request",
    "action-bump-version",
    "action-check-format",
    "action-find-dependencies",
    "action-generate-download-page",
    "action-generate-release-page",
    "action-merge-close-issue",
    "action-package-dependency",
    "action-publish-prebuilt",
    "action-purge-artifacts",
    "action-qa-automated",
    "action-release-note",
    "action-rollback-release",
    "action-set-collaborators",
    "action-sync-airtable",
    "action-sync-extensions-version",
    "action-sync-pr",
    "action-update-dependencies-version"
  ],
  "stableRefs": {
    "actions": "kungfu-systems/buildchain/actions/<name>@v2",
    "workflows": "kungfu-systems/buildchain/.github/workflows/<workflow>.yml@v2"
  },
  "verification": [
    "buildchain.toml lifecycle.verify",
    "pnpm install --frozen-lockfile",
    "pnpm run check",
    "GitHub Verify workflow",
    "Build Surface Fixture workflow",
    "manual Self-hosted Runner Smoke workflow"
  ],
  "safety": {
    "forkPrSecretsDefault": false,
    "selfHostedRunnerDefault": false,
    "trustedEventGate": true,
    "selfHostedRunnerManualWorkflow": "self-hosted-runner-smoke.yml",
    "reusableBuildWorkflow": ".build.yml",
    "reusableContract": {
      "runnerPresets": [
        "github-hosted",
        "kungfu-v4-self-hosted",
        "custom"
      ],
      "artifactNameTemplate": true,
      "expectedArtifactSummary": true,
      "aggregateSummaryArtifact": true,
      "publishGateChannels": true,
      "publishGateSourceLock": true,
      "resolvedReleaseManifest": true,
      "packageSetPublishPlan": true
    },
    "libnodeShapedFixture": "fixtures/libnode-shaped",
    "buildchainRefPromotionWorkflow": "buildchain-ref-promotion.yml",
    "npmPublish": {
      "workflow": "buildchain-ref-promotion.yml",
      "dryRunWorkflow": "npm-publish.yml",
      "promotionTransaction": true,
      "tagPushPublish": false,
      "exactVersionsOnly": true,
      "trustedPublishing": true,
      "githubHostedRunner": true,
      "manualDryRun": true,
      "manualDryRunPublishes": false,
      "alphaDistTag": "alpha",
      "stableDistTag": "latest"
    },
    "releasePassport": {
      "line": "v2.2",
      "protocolArtifacts": [
        "product-mechanism.json",
        "buildchain.release.json",
        "artifact-evidence.json",
        "impact.json",
        "agent-index.json",
        "llms.txt"
      ],
      "cli": [
        "collect github-release",
        "verify release-passport",
        "explain release --passport",
        "inspect release --passport"
      ],
      "binaryDistribution": {
        "workflow": "binary-distribution.yml",
        "productionRunnerDefault": "github-hosted",
        "selfHostedRole": "compatibility-fixture",
        "heavyPackageManagersDeferred": true
      }
    }
  }
}
