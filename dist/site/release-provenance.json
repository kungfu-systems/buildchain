{
  "schemaVersion": 1,
  "contract": "kungfu-buildchain-release-provenance",
  "package": {
    "name": "@kungfu-tech/buildchain",
    "versionSource": "package.json#version",
    "bin": {
      "buildchain": "./bin/buildchain.mjs"
    },
    "exports": {
      ".": "./packages/core/index.js",
      "./badges": "./packages/core/badges.js",
      "./build-facts": "./packages/core/build-facts.js",
      "./core": "./packages/core/index.js",
      "./artifact-passport": "./packages/core/artifact-passport.js",
      "./buildchain-contract": "./packages/core/buildchain-contract.js",
      "./diagnostics": "./packages/core/diagnostics.js",
      "./homebrew": "./packages/core/homebrew.js",
      "./issue-reporting": "./packages/core/issue-reporting.js",
      "./readme-badges": "./packages/core/readme-badges.js",
      "./logging": "./packages/core/logging.js",
      "./kfd-gate": "./packages/core/kfd-gate.js",
      "./release-candidate": "./packages/core/release-candidate.js",
      "./release-passport": "./packages/core/release-passport.js",
      "./release-propagation": "./packages/core/release-propagation.js",
      "./surface-manifest": "./packages/core/surface-manifest.js",
      "./buildchain-kfd-claims": "./packages/core/buildchain-kfd-claims.js",
      "./site/buildchain-site.json": "./dist/site/buildchain-site.json",
      "./site/site-manifest.json": "./dist/site/site-manifest.json",
      "./site/page-registry.json": "./dist/site/page-registry.json",
      "./site/cli-registry.json": "./dist/site/cli-registry.json",
      "./site/manual-registry.json": "./dist/site/manual-registry.json",
      "./site/node-api-registry.json": "./dist/site/node-api-registry.json",
      "./site/kfd-claims.json": "./dist/site/kfd-claims.json",
      "./site/workflow-registry.json": "./dist/site/workflow-registry.json",
      "./site/release-model.json": "./dist/site/release-model.json",
      "./site/artifact-schemas.json": "./dist/site/artifact-schemas.json",
      "./site/buildchain-contract.json": "./dist/site/buildchain-contract.json",
      "./site/product-mechanism.json": "./dist/site/product-mechanism.json",
      "./site/release-provenance.json": "./dist/site/release-provenance.json",
      "./site/agent-index.json": "./dist/site/agent-index.json",
      "./package.json": "./package.json"
    }
  },
  "repository": "https://github.com/kungfu-systems/buildchain",
  "packageManager": "pnpm@11.7.0",
  "inventoryRelease": "buildchain-v2",
  "stableRefs": {
    "actions": "kungfu-systems/buildchain/actions/<name>@v2",
    "workflows": "kungfu-systems/buildchain/.github/workflows/<workflow>.yml@v2"
  }
}
