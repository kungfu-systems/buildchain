    },
    {
      "id": "release-transaction",
      "source": "bin/buildchain.mjs",
      "usage": "buildchain release <inspect|recover|finalize|abort> ...",
      "purpose": "Inspect, recover, finalize, or abort durable release transactions."
    },
    {
      "id": "sample",
      "source": "bin/buildchain.mjs",
      "usage": "buildchain sample",
