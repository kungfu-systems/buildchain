{
  "schemaVersion": 1,
  "contract": "kungfu-buildchain-stable-release-policy",
  "enabled": true,
  "minimumStableIntervalSeconds": 86400,
  "minimumCanarySoakSeconds": 3600,
  "productPathPrefixes": [
    ".buildchain/stable-release-policy.json",
    ".github/workflows/",
    "actions/",
    "packages/",
    "scripts/"
  ],
  "requiredCanaries": [
    {
      "id": "build-surface-fixture",
      "source": "release-candidate",
      "repository": "kungfu-systems/buildchain",
      "workflow": "Build Surface Fixture",
      "allowedAttestors": []
    },
    {
      "id": "buildchain-zero-input",
      "source": "public-build",
      "repository": "kungfu-systems/buildchain",
      "workflow": "Buildchain Alpha Self-Dogfood",
      "context": "buildchain-canary/buildchain-zero-input",
      "allowedAttestors": [
        "github-actions[bot]"
      ]
    }
  ]
}
