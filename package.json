{
  "name": "@kungfu-tech/buildchain",
  "version": "2.12.5",
  "private": false,
  "description": "Buildchain Release Passport, release governance, CLI toolkit, and site facts.",
  "repository": "https://github.com/kungfu-systems/buildchain",
  "author": "Keren Dong",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "buildchain": "./bin/buildchain.mjs"
  },
  "exports": {
    ".": "./packages/core/index.js",
    "./badges": "./packages/core/badges.js",
    "./build-facts": "./packages/core/build-facts.js",
    "./core": "./packages/core/index.js",
    "./artifact-passport": "./packages/core/artifact-passport.js",
    "./buildchain-contract": "./packages/core/buildchain-contract.js",
    "./controller-evidence": "./packages/core/controller-evidence.js",
    "./diagnostics": "./packages/core/diagnostics.js",
    "./homebrew": "./packages/core/homebrew.js",
    "./issue-reporting": "./packages/core/issue-reporting.js",
    "./kfd": "./packages/core/kfd.js",
    "./buildchain-layout": "./packages/core/buildchain-layout.js",
    "./release-line-bootstrap": "./packages/core/release-line-bootstrap.js",
    "./readme-badges": "./packages/core/readme-badges.js",
    "./public-surface-audit": "./packages/core/public-surface-audit.js",
    "./logging": "./packages/core/logging.js",
    "./publication-artifact": "./packages/core/publication-artifact.js",
    "./publication-package": "./packages/core/publication-package.js",
    "./kfd-gate": "./packages/core/kfd-gate.js",
    "./release-candidate": "./packages/core/release-candidate.js",
    "./stable-candidate-ledger": "./packages/core/stable-candidate-ledger.js",
    "./release-passport": "./packages/core/release-passport.js",
    "./release-propagation": "./packages/core/release-propagation.js",
    "./surface-manifest": "./packages/core/surface-manifest.js",
    "./buildchain-kfd-claims": "./packages/core/buildchain-kfd-claims.js",
    "./site/buildchain-site.json": "./dist/site/buildchain-site.json",
    "./site/site-manifest.json": "./dist/site/site-manifest.json",
    "./site/publication-registry.json": "./dist/site/publication-registry.json",
    "./site/page-registry.json": "./dist/site/page-registry.json",
    "./site/capability-registry.json": "./dist/site/capability-registry.json",
    "./site/cli-registry.json": "./dist/site/cli-registry.json",
    "./site/manual-registry.json": "./dist/site/manual-registry.json",
    "./site/node-api-registry.json": "./dist/site/node-api-registry.json",
    "./site/kfd-claims.json": "./dist/site/kfd-claims.json",
    "./site/workflow-registry.json": "./dist/site/workflow-registry.json",
    "./site/controller-registry.json": "./dist/site/controller-registry.json",
    "./site/public-surface-audit.json": "./dist/site/public-surface-audit.json",
    "./site/kfd-upstream-aggregate.json": "./dist/site/kfd-upstream-aggregate.json",
    "./site/release-model.json": "./dist/site/release-model.json",
    "./site/artifact-schemas.json": "./dist/site/artifact-schemas.json",
    "./site/buildchain-contract.json": "./dist/site/buildchain-contract.json",
    "./site/product-mechanism.json": "./dist/site/product-mechanism.json",
    "./site/release-provenance.json": "./dist/site/release-provenance.json",
    "./site/agent-index.json": "./dist/site/agent-index.json",
    "./package.json": "./package.json"
  },
  "files": [
    "AGENTS.md",
    "bin/",
    "CONTRIBUTING.md",
    "LICENSE-POLICY.md",
    "scripts/*.mjs",
    "packages/core/",
    "dist/site/",
    "README.md",
    "SECURITY.md",
    "docs/*.md",
    "actions/*/README.md",
    "fixtures/*/README.md"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "check": "node scripts/check-inventory.mjs && pnpm run check:site && pnpm run check:workflows && pnpm run test:unit && pnpm -r --filter \"./actions/**\" build",
    "check:workflows": "bash scripts/check-workflows.sh",
    "generate:site": "node scripts/generate-site-bundle.mjs",
    "check:site": "node scripts/generate-site-bundle.mjs --check",
    "test:unit": "node --test tests/*.test.mjs",
    "build": "pnpm -r --filter \"./actions/**\" build",
    "binary:build": "node scripts/build-standalone-binary.mjs",
    "package": "npm pack --dry-run --json --registry=https://registry.npmjs.org/",
    "pack:check": "npm pack --dry-run --json --registry=https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@kungfu-tech/kfd": "1.0.0-alpha.21",
    "smol-toml": "1.7.0"
  }
}
